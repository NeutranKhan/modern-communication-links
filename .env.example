# Browser Firebase configuration (not service-account secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only. Use a restricted service account; never prefix these with NEXT_PUBLIC.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Trusted deployment origin for same-origin mutation checks
APP_URL=http://localhost:3000
# Random 32+ character secret used for keyed hashes and rate-limit buckets
LOOKUP_HASH_SECRET=
# Optional Google Search Console HTML verification token
GOOGLE_SITE_VERIFICATION=

# Server-only PUBLIC Blob store connection (custom prefix configured in Vercel)
mcl_photos_STORE_ID=
# Optional fallback for local use outside Vercel; never expose to the browser
mcl_photos_READ_WRITE_TOKEN=
# Default-prefix connections are also supported
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
